{
  "name": "live2d-react",
  "version": "0.1.0",
  "private": false,
  "description": "React component for Live2D Cubism 5 models",
  "keywords": ["live2d", "cubism", "react", "webgl"],
  "license": "MIT",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
